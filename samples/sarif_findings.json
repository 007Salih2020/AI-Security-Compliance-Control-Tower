{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "GitHub Advanced Security",
          "version": "1.0.0"
        }
      },
      "results": [
        {
          "ruleId": "GITHUB-001",
          "level": "error",
          "message": {
            "text": "Secret detected in repository history"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "infra/deploy.py"
                }
              }
            }
          ],
          "properties": {
            "provider": "GitHub",
            "service": "Repository",
            "resource_id": "github://controllens-ai/infra/deploy.py",
            "resource_name": "infra/deploy.py",
            "category": "Secrets Exposure",
            "remediation": "Revoke the exposed secret, rotate credentials, purge the commit history, and add secret scanning gates to CI/CD.",
            "control_ids": ["A.5.1", "RA-5", "CIS-16"],
            "compliance_frameworks": ["ISO 27001", "NIST 800-53", "SOC 2"],
            "created_at": "2026-06-01T08:51:00Z",
            "asset_criticality": "high",
            "internet_exposure": true,
            "compliance_relevance": "high",
            "exploitability": "high",
            "data_sensitivity": "confidential"
          }
        }
      ]
    }
  ]
}
